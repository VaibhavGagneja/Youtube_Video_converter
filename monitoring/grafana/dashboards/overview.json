                    "legendFormat": "{{method}} {{status}} {{endpoint}}"
                }
            ]
        },
        {
            "title": "Request Latency (Gateway)",
            "type": "timeseries",
            "datasource": "Prometheus",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 0
            },
            "targets": [
                {
                    "expr": "histogram_quantile(0.95, rate(flask_http_request_duration_seconds_bucket{job=\"gateway\"}[5m]))",
                    "legendFormat": "p95 {{endpoint}}"
                },
                {
                    "expr": "histogram_quantile(0.50, rate(flask_http_request_duration_seconds_bucket{job=\"gateway\"}[5m]))",
                    "legendFormat": "p50 {{endpoint}}"
                }
            ]
        },
        {
            "title": "Error Rate",
